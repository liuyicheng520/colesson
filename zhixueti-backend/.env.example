DEBUG=true
USE_SQLITE=true
SQLITE_PATH=data/edunexus.db
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:8082,http://127.0.0.1:8082,http://localhost:5173,http://127.0.0.1:5173
LLM_DEFAULT_PROVIDER=deepseek
LLM_FALLBACK_PROVIDER=mock
KB_ENABLED=true

JWT_SECRET_KEY=请填入你的密钥
HOST_BRIDGE_SECRET=请填入你的密钥
LOCAL_KB_DIR=data/knowledge
KB_INCLUDE_DIRS=raw
# 离线环境：跳过 fastembed 联网下载（否则每次冷启动检索会卡 40-50s）
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
DEEPSEEK_API_KEY=请填入你的密钥
