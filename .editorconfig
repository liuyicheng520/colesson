# 传智杯·AI WEB 网页开发挑战赛 — 统一代码风格
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 4
max_line_length = 120

[*.py]
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false
